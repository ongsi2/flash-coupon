# 공개 서버 배포용. .env.prod 로 복사한 뒤 값을 채우세요.
#
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# .env.prod 는 절대 커밋하지 마세요 (.gitignore에 등록되어 있습니다).
# 비밀번호 생성 예: openssl rand -base64 24

# --- 필수 ---
DB_PASSWORD=
REDIS_PASSWORD=

# 허용할 프론트엔드 도메인. 쉼표로 여러 개 지정 가능.
# 비워 두면 컨테이너가 뜨지 않습니다 (전체 허용을 실수로 배포하는 것을 막기 위함).
CORS_ORIGIN=https://example.com

# --- 선택 ---
DB_NAME=flashcoupon
DB_USER=postgres

# 최초 1회만 true로 띄워 테이블을 만든 뒤 false로 되돌리고 재기동하세요.
# 운영 중 true로 두면 엔티티 변경이 그대로 스키마에 반영됩니다.
DB_SYNCHRONIZE=false

# API가 바인딩할 루프백 포트. 외부 노출은 Nginx가 담당합니다.
PORT=3000

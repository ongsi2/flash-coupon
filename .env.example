# 이 파일을 .env 로 복사해서 사용하세요.
#   cp .env.example .env

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flashcoupon
DB_USER=postgres
DB_PASSWORD=postgres

# 엔티티로 테이블 자동 생성. 최초 1회 true, 이후 false 권장.
# 운영 및 부하 테스트에서는 반드시 false.
DB_SYNCHRONIZE=true

# 쿼리 로깅. 부하 테스트 결과를 왜곡하므로 벤치마크 시 반드시 false.
DB_LOGGING=false

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- App ---
PORT=3000
